<Window x:Class="RatePulse.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RatePulse"
        Width="380"
        Height="680"
        MinWidth="360"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        LocationChanged="Window_PlacementChanged"
        SizeChanged="Window_PlacementChanged">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#2B3344" />
            <Setter Property="BorderBrush" Value="#3B455A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#232938" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="#3B455A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="FieldCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#232938" />
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="BorderBrush" Value="#3B455A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="RateItemButton" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown"
            CornerRadius="18"
            Background="#F61D2029"
            BorderBrush="#333B4D"
            BorderThickness="1"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#37D67A" Margin="0,0,8,0" />
                    <TextBlock Text="RatePulse"
                               Foreground="#F4F7FB"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Width="34"
                            x:Name="LanguageButton"
                            Height="30"
                            Margin="0,0,6,0"
                            Style="{StaticResource ChromeButton}"
                            Click="LanguageButton_Click"
                            ToolTip="Switch language"
                            Content="ZH" />
                    <Button Width="30"
                            x:Name="SettingsButton"
                            Height="30"
                            Margin="0,0,6,0"
                            Style="{StaticResource ChromeButton}"
                            Click="SettingsButton_Click"
                            ToolTip="Settings"
                            Content="S" />
                    <Button Width="30"
                            x:Name="RefreshButton"
                            Height="30"
                            Margin="0,0,6,0"
                            Style="{StaticResource ChromeButton}"
                            Click="RefreshButton_Click"
                            ToolTip="Refresh rates and conversion"
                            Content="R" />
                    <Button Width="30"
                            x:Name="MinimizeButton"
                            Height="30"
                            Margin="0,0,6,0"
                            Style="{StaticResource ChromeButton}"
                            Click="MinimizeButton_Click"
                            ToolTip="Minimize to tray"
                            Content="_" />
                    <Button Width="30"
                            x:Name="CloseButton"
                            Height="30"
                            Style="{StaticResource ChromeButton}"
                            Click="CloseButton_Click"
                            ToolTip="Exit"
                            Content="X" />
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="1"
                       x:Name="StatusText"
                       Margin="0,8,0,12"
                       Foreground="#9EA7B8"
                       FontSize="12"
                       Text="Preparing exchange rates..." />

            <Border Grid.Row="2"
                    CornerRadius="12"
                    Background="#232938"
                    BorderBrush="#30384B"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="ConverterTitleText"
                               Text="USD bridge converter"
                               Foreground="#F4F7FB"
                               FontSize="14"
                               FontWeight="SemiBold" />

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ConverterAmountTextBox"
                                     Style="{StaticResource FieldBox}"
                                     ToolTip="Amount"
                                     TextChanged="ConverterInput_Changed" />
                            <Button Grid.Column="1"
                                    x:Name="ConvertButton"
                                    Margin="8,0,0,0"
                                    Content="Convert"
                                    Click="ConvertButton_Click" />
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ConverterSourceComboBox"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      Style="{StaticResource FieldCombo}"
                                      ToolTip="Source currency"
                                      SelectionChanged="ConverterCurrencyComboBox_SelectionChanged"
                                      KeyUp="ConverterCurrencyComboBox_KeyUp"
                                      LostKeyboardFocus="ConverterCurrencyComboBox_LostKeyboardFocus" />
                            <TextBlock Grid.Column="1"
                                       x:Name="ViaUsdInlineText"
                                       Text="→ USD →"
                                       Margin="8,0"
                                       Foreground="#8D96A8"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <ComboBox Grid.Column="2"
                                      x:Name="ConverterTargetComboBox"
                                      IsEditable="True"
                                      IsTextSearchEnabled="True"
                                      StaysOpenOnEdit="True"
                                      Style="{StaticResource FieldCombo}"
                                      ToolTip="Target currency"
                                      SelectionChanged="ConverterCurrencyComboBox_SelectionChanged"
                                      KeyUp="ConverterCurrencyComboBox_KeyUp"
                                      LostKeyboardFocus="ConverterCurrencyComboBox_LostKeyboardFocus" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="ConversionSourceText"
                                   Foreground="#D7DCE7"
                                   FontSize="13" />
                        <TextBlock x:Name="ViaUsdText"
                                   Text="via USD"
                                   Margin="0,4,0,4"
                                   Foreground="#8D96A8"
                                   FontSize="11" />
                        <TextBlock x:Name="ConversionUsdText"
                                   Foreground="#7BE3A2"
                                   FontSize="18"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ConversionTargetText"
                                   Margin="0,6,0,0"
                                   Foreground="#F4F7FB"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="ConversionMetaText"
                                   Margin="0,8,0,0"
                                   Foreground="#8D96A8"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    x:Name="HistoryPanel"
                    Visibility="Collapsed"
                    CornerRadius="12"
                    Background="#202634"
                    BorderBrush="#30384B"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel LastChildFill="True">
                        <TextBlock x:Name="HistoryTitleText"
                                   DockPanel.Dock="Left"
                                   Foreground="#F4F7FB"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="HistoryStatusText"
                                   DockPanel.Dock="Right"
                                   Foreground="#8D96A8"
                                   FontSize="10"
                                   TextAlignment="Right" />
                    </DockPanel>

                    <Canvas Grid.Row="1"
                            x:Name="HistoryChartCanvas"
                            Margin="0,10,0,0"
                            Background="#191E29"
                            SizeChanged="HistoryChartCanvas_SizeChanged" />

                    <TextBlock Grid.Row="2"
                               x:Name="HistoryRangeText"
                               Margin="0,8,0,0"
                               Foreground="#8D96A8"
                               FontSize="10"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <TextBlock Grid.Row="4"
                       x:Name="WatchlistTitleText"
                       Text="Watchlist"
                       Foreground="#D7DCE7"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />

            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Rates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RateItemButton}"
                                    CommandParameter="{Binding}"
                                    Click="RateItem_Click">
                                <Border Margin="0,0,0,8"
                                        CornerRadius="10"
                                        Background="#232938"
                                        BorderBrush="#30384B"
                                        BorderThickness="1"
                                        Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayPair}"
                                                       Foreground="#F4F7FB"
                                                       FontSize="14"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding UpdatedAtText}"
                                                       Margin="0,3,0,0"
                                                       Foreground="#8D96A8"
                                                       FontSize="11" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding RateText}"
                                                       Foreground="#7BE3A2"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Right" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Source}"
                                                           Margin="0,3,6,0"
                                                           Foreground="#7C8495"
                                                           FontSize="10"
                                                           TextAlignment="Right" />
                                                <TextBlock Text="{Binding DisplayDataState}"
                                                           Margin="0,3,0,0"
                                                           Foreground="#B2BAC9"
                                                           FontSize="10"
                                                           TextAlignment="Right" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="6" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RefreshIntervalText"
                           Foreground="#7C8495"
                           FontSize="11" />
                <TextBlock Grid.Column="1"
                           x:Name="TopmostText"
                           Foreground="#7C8495"
                           FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
