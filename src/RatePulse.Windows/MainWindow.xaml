<Window x:Class="RatePulse.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RatePulse"
        Width="300"
        Height="360"
        MinWidth="280"
        MinHeight="320"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#2B3344" />
            <Setter Property="BorderBrush" Value="#3B455A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown"
            CornerRadius="18"
            Background="#F61D2029"
            BorderBrush="#333B4D"
            BorderThickness="1"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#37D67A" Margin="0,0,8,0" />
                    <TextBlock Text="RatePulse"
                               Foreground="#F4F7FB"
                               FontSize="18"
                               FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Width="30"
                            Height="30"
                            Margin="0,0,6,0"
                            Style="{StaticResource ChromeButton}"
                            Click="RefreshButton_Click"
                            ToolTip="Refresh rates"
                            Content="↻" />
                    <Button Width="30"
                            Height="30"
                            Style="{StaticResource ChromeButton}"
                            Click="CloseButton_Click"
                            ToolTip="Close"
                            Content="×" />
                </StackPanel>
            </DockPanel>

            <TextBlock Grid.Row="1"
                       x:Name="StatusText"
                       Margin="0,8,0,14"
                       Foreground="#9EA7B8"
                       FontSize="12"
                       Text="Preparing exchange rates..." />

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Rates}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8"
                                CornerRadius="10"
                                Background="#232938"
                                BorderBrush="#30384B"
                                BorderThickness="1"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Pair}"
                                               Foreground="#F4F7FB"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdatedAtText}"
                                               Margin="0,3,0,0"
                                               Foreground="#8D96A8"
                                               FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding RateText}"
                                               Foreground="#7BE3A2"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               TextAlignment="Right" />
                                    <TextBlock Text="{Binding Source}"
                                               Margin="0,3,0,0"
                                               Foreground="#7C8495"
                                               FontSize="10"
                                               TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto refresh: 5 min"
                           Foreground="#7C8495"
                           FontSize="11" />
                <TextBlock Grid.Column="1"
                           Text="Always on top"
                           Foreground="#7C8495"
                           FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>
