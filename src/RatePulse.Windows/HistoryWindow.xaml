<Window x:Class="RatePulse.Windows.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatePulse History"
        Width="520"
        Height="360"
        MinWidth="440"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#1D2029">
    <Border Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="HistoryTitleText"
                               Foreground="#F4F7FB"
                               FontSize="16"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="HistorySubtitleText"
                               Margin="0,4,0,0"
                               Foreground="#8D96A8"
                               FontSize="11" />
                </StackPanel>

                <TextBlock x:Name="HistoryStatusText"
                           DockPanel.Dock="Right"
                           Foreground="#8D96A8"
                           FontSize="11"
                           TextAlignment="Right"
                           VerticalAlignment="Top" />
            </DockPanel>

            <Canvas Grid.Row="1"
                    x:Name="HistoryChartCanvas"
                    Margin="0,14,0,0"
                    Background="#191E29"
                    SizeChanged="HistoryChartCanvas_SizeChanged" />

            <TextBlock Grid.Row="2"
                       x:Name="HistoryRangeText"
                       Margin="0,10,0,0"
                       Foreground="#8D96A8"
                       FontSize="11"
                       TextWrapping="Wrap" />
        </Grid>
    </Border>
</Window>
