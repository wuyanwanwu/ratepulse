<Window x:Class="RatePulse.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RatePulse Settings"
        Width="360"
        Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1D2029">
    <Border Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="SettingsTitleText"
                       Text="Settings"
                       Foreground="#F4F7FB"
                       FontSize="22"
                       FontWeight="SemiBold" />

            <StackPanel Grid.Row="1" Margin="0,18,0,12">
                <TextBlock x:Name="CurrencyPairsLabel"
                           Text="Currency pairs"
                           Foreground="#D7DCE7"
                           FontSize="13"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="CurrencyPairsHint"
                           Text="One pair per line, like USD/CNY."
                           Margin="0,4,0,8"
                           Foreground="#8D96A8"
                           FontSize="12" />
            </StackPanel>

            <TextBox Grid.Row="2"
                     x:Name="PairsTextBox"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="#232938"
                     Foreground="#F4F7FB"
                     BorderBrush="#3B455A"
                     Padding="10"
                     FontFamily="Consolas"
                     FontSize="13" />

            <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="132" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="LanguageLabel"
                               Text="Language"
                               Foreground="#D7DCE7"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Column="1"
                              x:Name="LanguageComboBox"
                              SelectedValuePath="Tag"
                              SelectionChanged="LanguageComboBox_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="中文" Tag="zh" />
                    </ComboBox>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="RefreshIntervalLabel"
                               Text="Refresh interval (minutes)"
                               Foreground="#D7DCE7"
                               VerticalAlignment="Center" />

                    <TextBox Grid.Column="1"
                             x:Name="RefreshIntervalTextBox"
                             Background="#232938"
                             Foreground="#F4F7FB"
                             BorderBrush="#3B455A"
                             Padding="8"
                             TextAlignment="Right" />
                </Grid>

                <CheckBox x:Name="TopmostCheckBox"
                          Margin="0,12,0,0"
                          Content="Always on top"
                          Foreground="#D7DCE7" />

                <TextBlock x:Name="ValidationText"
                           Margin="0,10,0,0"
                           Foreground="#FF8080"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Width="84"
                            Height="32"
                            Margin="0,0,8,0"
                            Click="CancelButton_Click" />
                    <Button x:Name="SaveButton"
                            Content="Save"
                            Width="84"
                            Height="32"
                            Click="SaveButton_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
